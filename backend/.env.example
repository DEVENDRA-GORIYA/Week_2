# Copy to backend/.env. Environment variables override this file.

APP_NAME=Helix Inference Gateway
DEBUG=true
SECRET_KEY=dev-only-change-me-not-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated emails that receive the admin role at registration.
ADMIN_EMAILS=

DATABASE_URL=sqlite+aiosqlite:///./helix.db
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ollama | groq | anthropic | openai_compatible
INFERENCE_PROVIDER=ollama

# Local open model via Ollama (OpenAI-compatible endpoint).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=smollm2:135m
OLLAMA_API_KEY=ollama

# Free-tier Groq. Required only when INFERENCE_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Anthropic / IBM ICA Messages API.
# ICA gateway example:
#   ANTHROPIC_BASE_URL=https://api.nextgen-beta.ica.ibm.com/ica
#   ANTHROPIC_AUTH_TOKEN=sk-...
# Public Anthropic example:
#   ANTHROPIC_BASE_URL=https://api.anthropic.com
#   ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_BASE_URL=https://api.nextgen-beta.ica.ibm.com/ica
ANTHROPIC_API_VERSION=2023-06-01

# Any OpenAI-compatible server (llama.cpp, vLLM, OpenRouter, ...).
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Per-user controls. RPM is in-memory for this single process.
RATE_LIMIT_RPM=30
DAILY_TOKEN_BUDGET=20000
MAX_TOOL_STEPS=3
